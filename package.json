{
  "name": "project-anvil-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.16.0",
    "npm": ">=11.13.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node scripts/run-node-tests.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run test",
    "build": "vite build && node scripts/write-artifact-manifest.mjs"
  },
  "dependencies": {
    "box3d.js": "0.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.1",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "packageManager": "npm@11.13.0"
}
